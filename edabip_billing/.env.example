# ---- Database ----
# If EDABIP's existing backend already sets DATABASE_URL, this module
# reuses it automatically - only set BILLING_DATABASE_URL if billing
# needs to point somewhere different (e.g. a separate schema).
# NOTE: this is a sample file - put your real local password only in
# your own untracked .env, never here.
DATABASE_URL=mysql+pymysql://root:12345@localhost:3306/edabip

# ---- Razorpay ----
# Get your test mode Key ID/Secret from
# https://dashboard.razorpay.com/app/keys while developing - keep using
# test mode keys until you are genuinely ready to take live payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set this after you register the /api/billing/webhooks/razorpay
# endpoint under Settings -> Webhooks in the Razorpay Dashboard (see
# README "Razorpay setup"). This is what verifies a webhook request
# really came from Razorpay and not someone else.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Amount (in paise) charged then immediately refunded to verify/save a
# new card when there's no real purchase happening yet.
RAZORPAY_CARD_VERIFICATION_AMOUNT=100

# ---- Business rules (all optional - sane defaults shown) ----
BILLING_GRACE_PERIOD_DAYS=7
BILLING_USAGE_WARNING_PCT=80
BILLING_USAGE_CRITICAL_PCT=95
BILLING_DEFAULT_CURRENCY=inr
BILLING_EXPIRY_ALERT_DAYS=5

# ---- CORS ----
# Comma-separated list of origins allowed to call this API from the
# browser. Defaults already cover the Vite dev server, so you only need
# to set this for a deployed frontend URL.
BILLING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
